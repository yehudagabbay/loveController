{
  "expo": {
    "name": "LIBA",
    "slug": "liba-game",
    "owner": "libsa-team",
    "scheme": [
      "loveclient",
      "com.googleusercontent.apps.726714686390-pv5i7cm3k5rhtdbl1aea0hpn3ar9mqpp",
