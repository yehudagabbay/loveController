{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "iosSimulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "iosDevelopment": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {}
    },
    "iosInternal": {
      "distribution": "internal",
      "ios": {}
    },
    "iosProduction": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {}
    }
  },
  "submit": {
    "iosProduction": {
      "ios": {}
    }
  }
}
